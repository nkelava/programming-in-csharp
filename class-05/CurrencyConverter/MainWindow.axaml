<Window x:Class="CurrencyConverter.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CurrencyConverter"
        Title="Currency Converter" Height="411" Width="784">
    <Grid>
        <Label HorizontalAlignment="Center" Margin="0,33,0,0" VerticalAlignment="Top" FontSize="26" FontWeight="SemiBold">
            <TextBlock TextDecorations="Underline" Height="37">Currency Converter</TextBlock>
        </Label>

        <Label Content="Convert from:" HorizontalAlignment="Left" Margin="144,127,0,0" VerticalAlignment="Top" Width="100" Padding="5" FontWeight="SemiBold"/>
        <ComboBox Name="cmbBoxFrom" HorizontalAlignment="Left" x:DataType="local:Currency" DisplayMemberBinding="{Binding Code}" SelectedValueBinding="{Binding MiddleRate}" SelectedIndex="0" VerticalAlignment="Top" Width="210" Margin="144,158,0,0" Height="29" DropDownClosed="FromDropDownClosed" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <TextBox Name="txtBoxFrom" HorizontalAlignment="Left" Height="23" Margin="144,204,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="210" VerticalContentAlignment="Center" TextAlignment="Right" TextChanged="txtBoxFrom_TextChanged" Padding="0,0,5,0"/>

        <Label Content="Convert to:" HorizontalAlignment="Left" Margin="440,127,0,0" VerticalAlignment="Top" Width="100" Padding="5" FontWeight="SemiBold"/>
        <ComboBox Name="cmbBoxTo" HorizontalAlignment="Left" x:DataType="local:Currency" DisplayMemberBinding="{Binding Code}" SelectedValueBinding="{Binding MiddleRate}" SelectedIndex="0" Margin="440,158,0,0" VerticalAlignment="Top" Width="210" Height="29" DropDownClosed="ToDropDownClosed" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox Name="txtBoxTo" HorizontalAlignment="Left" Height="23" Margin="440,204,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" VerticalContentAlignment="Center" TextAlignment="Right" IsReadOnly="True" Padding="0,0,5,0"/>
    </Grid>
</Window>
